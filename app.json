{
  "expo": {
    "name": "Moniva",
    "slug": "expense-tracker",
    "scheme": "moniva",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#10231F"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.atacan.expensetracker",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.atacan.expensetracker",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Söylediğiniz harcamaları metne dönüştürüp onayınıza sunmak için mikrofonunuza erişim gerekiyor."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Fiş ve faturalarınızın fotoğrafını çekerek harcama bilgilerini analiz etmek için kameranıza erişim gerekiyor.",
          "photosPermission": "Seçtiğiniz fiş ve fatura fotoğraflarını analiz etmek için fotoğraflarınıza erişim gerekiyor."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#10231F"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-4858173270247933~7461948738",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713"
        }
      ]
    ],
    "extra": {
      "API_BASE_URL": "https://expense-tracker-backend-production-6baf.up.railway.app",
      "VOICE_ACCESS_TEST_MODE": false,
      "REVENUECAT_IOS_API_KEY": "appl_OTagbknHQSZoUHnWRAZTAoYNtcd",
      "REVENUECAT_ANDROID_API_KEY": "goog_EiwihbSshtEWgnspTQAxJUzHFjN",
      "ADMOB_IOS_BANNER_ID": "ca-app-pub-4858173270247933/4835785391",
      "ADMOB_IOS_INTERSTITIAL_ID": "ca-app-pub-4858173270247933/2923937924",
      "ADMOB_ANDROID_BANNER_ID": "",
      "ADMOB_ANDROID_INTERSTITIAL_ID": "",
      "router": {},
      "eas": {
        "projectId": "0c76f60a-2c61-4e75-8712-a5692c580d95"
      }
    }
  }
}
